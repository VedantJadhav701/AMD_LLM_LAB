{
  "name": "amd-llm-lab-desktop",
  "productName": "AMD LLM Lab",
  "version": "0.1.0",
  "description": "Find out which LLMs your laptop can really run, then test them.",
  "author": "Vedant Jadhav <vedantjadhav1414@gmail.com>",
  "license": "MIT",
  "private": true,
  "main": "dist/main/index.js",
  "homepage": "https://github.com/VedantJadhav701/AMD_LLM_LAB",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "vitest run",
    "e2e": "node e2e/run.mjs",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:mac": "npm run build && electron-builder --mac"
  },
  "devDependencies": {
    "@fontsource/barlow": "^5.2.5",
    "@fontsource/barlow-semi-condensed": "^5.2.5",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "lucide-react": "^0.468.0",
    "playwright-core": "^1.50.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
